# DexSlide Firmware Makefile
# Target: STM32F103RCT6 (Cortex-M3, 256KB Flash, 48KB RAM)
#
# Prerequisites:
#   - arm-none-eabi-gcc toolchain
#   - STM32F1xx HAL drivers (place in Drivers/)
#   - STM32 USB Device middleware (generated by CubeMX)
#
# This Makefile is a structural template. A complete build requires
# CubeMX-generated startup files, linker script, and USB middleware.

######################################
# Target
######################################
TARGET = dexslide_fw

######################################
# Toolchain
######################################
PREFIX = arm-none-eabi-
CC = $(PREFIX)gcc
AS = $(PREFIX)gcc -x assembler-with-cpp
CP = $(PREFIX)objcopy
SZ = $(PREFIX)size

######################################
# Paths
######################################
BUILD_DIR = build

C_SOURCES = \
Core/Src/main.c \
Core/Src/ads1115.c \
Core/Src/usb_comm.c \
Core/Src/lcd_driver.c
# TODO: Add HAL sources, USB middleware sources, system_stm32f1xx.c

ASM_SOURCES = \
# TODO: startup_stm32f103xc.s (from CubeMX or CMSIS)

######################################
# CFLAGS
######################################
CPU = -mcpu=cortex-m3
FPU =
FLOAT-ABI =
MCU = $(CPU) -mthumb $(FPU) $(FLOAT-ABI)

C_DEFS = \
-DUSE_HAL_DRIVER \
-DSTM32F103xE

C_INCLUDES = \
-ICore/Inc \
-IDrivers/STM32F1xx_HAL_Driver/Inc \
-IDrivers/CMSIS/Device/ST/STM32F1xx/Include \
-IDrivers/CMSIS/Include

CFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) -Wall -fdata-sections -ffunction-sections -Og -g

######################################
# Linker
######################################
LDSCRIPT = STM32F103RCTx_FLASH.ld
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) -lc -lm -lnosys \
          -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections

######################################
# Build
######################################
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))

$(BUILD_DIR)/%.o: %.c | $(BUILD_DIR)
	$(CC) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS)
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/$(TARGET).bin: $(BUILD_DIR)/$(TARGET).elf
	$(CP) -O binary $< $@

$(BUILD_DIR):
	mkdir -p $@

all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).bin

clean:
	rm -rf $(BUILD_DIR)

flash: $(BUILD_DIR)/$(TARGET).bin
	st-flash write $< 0x08000000

.PHONY: all clean flash
